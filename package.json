{
  "name": "tangente",
  "private": true,
  "type": "module",
  "description": "Jeu de courbes multijoueur : PC/TV en arène, smartphones en manettes (Nuxt + Nitro WebSocket)",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "start": "node scripts/start.mjs",
    "soiree": "node scripts/start.mjs --build --tunnel cloudflared",
    "stop": "node scripts/start.mjs --stop",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:load": "node scripts/load-test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "typecheck": "nuxt typecheck",
    "format": "prettier --check app game shared server tests scripts nuxt.config.ts vitest.config.ts",
    "format:fix": "prettier --write app game shared server tests scripts nuxt.config.ts vitest.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "node-datachannel": "^0.33.6",
    "nuxt": "^4.5.2",
    "uqr": "^0.1.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.6",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@10.33.0"
}
